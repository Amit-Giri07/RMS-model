<h1>Orders</h1>

<%= link_to "New Order", new_order_path %>

<table>
  <tr>
    <th>Order Number</th>
    <th>Table</th>
    <th>Status</th>
    <th>Total</th>
    <th></th>
  </tr>

  <% @orders.each do |order| %>
    <tr>
      <td><%= order.order_number %></td>
      <td><%= order.dining_table.table_number %></td>
      <td><%= order.status %></td>
      <td>Rs. <%= order.calculate_total %></td>
      <td>
        <%= link_to "View", order_path(order) %>
      </td>
      <td>
        <%= button_to "Remove",
            order_path(order),
            method: :delete %>
      </td>
    </tr>
  <% end %>
</table>