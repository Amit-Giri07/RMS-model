<h1>Kitchen Dashboard</h1>

<% @orders.each do |order| %>

    <p>
        <%= order.order_number %>
        -
        <%= order.status %>
    </p>

<%= button_to "Preparing",
    order_path(order,
    order: { status: :preparing }),
    method: :patch %>

<%= button_to "Ready",
    order_path(order,
    order: { status: :ready }),
    method: :patch %>
<% end %>

