<h1>Payments</h1>

<table>
    <thead>
        <tr>
            <th>Order</th>
            <th>Amount</th>
            <th>Method</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        <% @payments.each do |payment| %>
        <tr>
            <td>
                <%= payment.order.order_number%>
            </td>

            <td>
                Rs. <%= payment.amount%>
            </td>

            <td>
                <%= payment.payment_method%>
            </td>

            <td>
                <%= payment.status%>
            </td>
        </tr>
        <% end %>
    </tbody>
</table>